#!/bin/bash

set -euo pipefail

offline_mirror_dir="$1"
packages=(omarchy-settings-dev omarchy-dev omarchy-nvim)

for package in "${packages[@]}"; do
  if ! compgen -G "$offline_mirror_dir/$package-*.pkg.tar.zst" >/dev/null; then
    echo "ERROR: baseline package is missing from the shared mirror: $package" >&2
    exit 1
  fi
done

echo "Reusing the baseline's identical locally-built Omarchy packages:"
for package in "${packages[@]}"; do
  printf '  %s\n' "$offline_mirror_dir/$package-"*.pkg.tar.zst
done
